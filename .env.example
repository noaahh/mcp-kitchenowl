# --- Required ---

# Base URL of your KitchenOwl instance (no trailing /api).
KITCHENOWL_URL=https://kitchenowl.example.com

# Long-lived access token for the KitchenOwl user the MCP server acts as.
# Mint one in the KitchenOwl app: Profile -> Sessions -> add long-lived token.
# Or programmatically:
#   curl -X POST $KITCHENOWL_URL/api/auth -H 'Content-Type: application/json' \
#        -d '{"username":"you","password":"..."}'          # -> access_token
#   curl -X POST $KITCHENOWL_URL/api/auth/llt -H "Authorization: Bearer <access_token>" \
#        -H 'Content-Type: application/json' -d '{"device":"kitchenowl-mcp"}'
KITCHENOWL_TOKEN=

# --- Optional ---

# Default household id. If unset and the user has exactly one household,
# it is picked automatically.
#KITCHENOWL_HOUSEHOLD_ID=1

# Bind address / port / path of the MCP HTTP endpoint.
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#MCP_PATH=/mcp

# If set, MCP clients must send "Authorization: Bearer <this token>".
# If unset, the endpoint is unauthenticated - only expose it on trusted networks.
#MCP_SERVER_TOKEN=

# Only used by docker-compose for the bundled KitchenOwl service.
#JWT_SECRET_KEY=change-me
